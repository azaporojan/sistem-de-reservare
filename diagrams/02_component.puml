@startuml Component_ProjectStructure
!theme plain
skinparam backgroundColor #FAFAFA
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #F4F8FF
  BorderColor #2C6FAC
}
skinparam database {
  BackgroundColor #FFF5E6
  BorderColor #E6800A
}
skinparam ArrowColor #555555

title Component — Project Structure (Layers)

package "REST Layer" {
  [AuthController]
  [RoomController]
  [ReservationController]
  [UserController]
}

package "Service Layer" {
  [AuthService]
  [RoomService]
  [ReservationService]
  [UserService]
  [BookingRulesValidator]
}

package "Security" {
  [JwtAuthFilter]
  [JwtService]
  [SecurityConfig]
}

package "Persistence (Spring Data JPA)" {
  [UserRepository]
  [RoleRepository]
  [RoomRepository]
  [ReservationRepository]
  [RefreshTokenRepository]
  [Permission Repositories]
}

package "Scheduled Jobs" {
  [CompletionScheduler]
}

package "Config" {
  [AppProperties]
  [FlywayConfig]
  [OpenApiConfig]
}

database "PostgreSQL" as DB

[REST Layer]        --> [Service Layer]
[Service Layer]     --> [Persistence (Spring Data JPA)]
[JwtAuthFilter]     --> [REST Layer]
[SecurityConfig]    --> [JwtAuthFilter]
[CompletionScheduler] --> [ReservationRepository]
[Persistence (Spring Data JPA)] --> DB
[FlywayConfig]      ..> DB : migrations

@enduml

' ─────────────────────────────────────────────────────────────

@startuml Component_AuthSecurity
!theme plain
skinparam backgroundColor #FAFAFA
skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #EEF5FF
  BorderColor #2C6FAC
}
skinparam ArrowColor #2C6FAC

title Component — Authentication & Security

actor "Client" as Client

[JwtAuthFilter] --> [JwtService]       : validate token\nextract userId + permissions
[SecurityConfig] --> [JwtAuthFilter]   : registers

Client --> [JwtAuthFilter]             : Bearer <token>
[JwtAuthFilter] --> [AuthController]  : /api/auth/**\n(permit all)
[JwtAuthFilter] --> [OtherControllers] : authenticated requests

[AuthController] --> [AuthService]
[AuthService]    --> [UserRepository]         : find/save user
[AuthService]    --> [RoleRepository]         : find role
[AuthService]    --> [UserRoleRepository]     : assign role
[AuthService]    --> [RolePermissionRepository] : load permissions
[AuthService]    --> [UserPermissionRepository] : extra permissions
[AuthService]    --> [JwtService]             : generateToken()
[AuthService]    --> [RefreshTokenRepository] : save / revoke token

note right of [JwtService]
  Signs & validates JWT.
  Claims: userId, role,
  permissions[], exp
end note

note right of [RefreshTokenRepository]
  TTL: 30 days.
  Old token revoked
  on refresh (rotation).
end note

@enduml

' ─────────────────────────────────────────────────────────────

@startuml Component_RoomManagement
!theme plain
skinparam backgroundColor #FAFAFA
skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #EEF5FF
  BorderColor #2C6FAC
}
skinparam ArrowColor #2C6FAC

title Component — Room Management

actor "Admin"  as Admin
actor "User"   as User

User  --> [RoomController]  : GET /api/rooms\nGET /api/rooms/{id}\nGET /api/rooms/{id}/availability
Admin --> [RoomController]  : POST / PATCH / DELETE\n/api/rooms

[RoomController] --> [RoomService]

[RoomService] --> [RoomRepository]        : CRUD study_rooms
[RoomService] --> [ReservationRepository] : findConflicting()\n(for availability check)

note right of [RoomService]
  Soft availability check:
  returns conflicting slots
  without throwing.
end note

@enduml

' ─────────────────────────────────────────────────────────────

@startuml Component_ReservationBooking
!theme plain
skinparam backgroundColor #FAFAFA
skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #EEF5FF
  BorderColor #2C6FAC
}
skinparam ArrowColor #2C6FAC

title Component — Reservation Booking & Validation

actor "Teacher / Admin" as Teacher
actor "Student"         as Student

Teacher --> [ReservationController] : POST /reservations/room
Student --> [ReservationController] : POST /reservations/seat

[ReservationController] --> [ReservationService]

[ReservationService] --> [RoomRepository]           : findById()
[ReservationService] --> [BookingRulesValidator]    : validateRoomBooking()\nvalidateSeatBooking()
[ReservationService] --> [ReservationRepository]    : save()

[BookingRulesValidator] --> [UserRoleRepository]    : get user role\n(TEACHER / STUDENT rules)
[BookingRulesValidator] --> [ReservationRepository] : countActive()\nfindConflicting()

note right of [BookingRulesValidator]
  Rules:
  · 30-min aligned slots
  · max 2-day duration
  Teacher: ≤200 cap, ≤30d advance, ≤2 active
  Student: ≤14d advance, ≤1 active
  Both: no overlapping slots
end note

@enduml

' ─────────────────────────────────────────────────────────────

@startuml Component_ReservationAdmin
!theme plain
skinparam backgroundColor #FAFAFA
skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #EEF5FF
  BorderColor #2C6FAC
}
skinparam ArrowColor #2C6FAC

title Component — Reservation Review & Cancellation

actor "Admin" as Admin
actor "User"  as User

Admin --> [ReservationController] : POST /{id}/confirm\nPOST /{id}/decline\nGET /reservations
User  --> [ReservationController] : DELETE /{id}\nGET /reservations/my

[ReservationController] --> [ReservationService]
[ReservationService]    --> [ReservationRepository] : findById()\nsave()

note right of [ReservationService]
  confirm / decline:
    PENDING → CONFIRMED / DECLINED
  cancel:
    PENDING | CONFIRMED → CANCELLED
    guard: startTime > now
end note

@enduml

' ─────────────────────────────────────────────────────────────

@startuml Component_UserManagement
!theme plain
skinparam backgroundColor #FAFAFA
skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #EEF5FF
  BorderColor #2C6FAC
}
skinparam ArrowColor #2C6FAC

title Component — User Management

actor "Admin" as Admin
actor "User"  as User

User  --> [UserController] : GET /users/me\nPATCH /users/me
Admin --> [UserController] : GET|POST|PATCH|DELETE /users\nPOST|DELETE /users/{id}/permissions

[UserController] --> [UserService]

[UserService] --> [UserRepository]            : CRUD users
[UserService] --> [RoleRepository]            : find role
[UserService] --> [UserRoleRepository]        : assign / change role
[UserService] --> [PermissionRepository]      : find permission
[UserService] --> [UserPermissionRepository]  : grant / revoke
[UserService] --> [RolePermissionRepository]  : build effective permissions

note right of [UserService]
  Effective permissions =
  role permissions
  + extra user permissions.
  If role has ALL → full access.
end note

@enduml

' ─────────────────────────────────────────────────────────────

@startuml Component_ExpiryJob
!theme plain
skinparam backgroundColor #FAFAFA
skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #EEF5FF
  BorderColor #2C6FAC
}
skinparam ArrowColor #2C6FAC

title Component — Completion Scheduler (Expiry Job)

component "CompletionScheduler\n@Scheduled(cron = \"0 0/30 * * * *\")" as Scheduler
component "ReservationRepository" as Repo
database  "PostgreSQL" as DB

Scheduler --> Repo : findConfirmedPastEnd(now)\n→ status=CONFIRMED AND end < now
Repo      --> DB
Scheduler --> Repo : saveAll(status = COMPLETED)

note right of Scheduler
  Runs every 30 minutes.
  Transitions:
  CONFIRMED → COMPLETED
  when endDateTime has passed.
end note

@enduml
